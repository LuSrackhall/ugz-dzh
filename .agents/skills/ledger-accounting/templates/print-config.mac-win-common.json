      "rowScale": 0.992,
      "fonts": {
        "normal": "宋体",
        "digit": "Noteworthy",
        "title": "仿宋",
        "default": "宋体",
        "labelFamily": "等线 Light"
      },
      "gl": {
        "colScale": 1.13595,
        "rowScale": 0.99495,
        "frontColScale": 1.13595,
        "backColScale": 1.13595,
        "backOuterDelta": -8
      },
      "ml": {
        "colScale": 1.1198,
        "rowScale": 0.996,
        "frontColScale": 1.11809,
        "backColScale": 1.11809,
        "frontBindingDelta": -18,
        "frontDigitDelta": {
          "k9": -1
        },
        "backOuterDelta": -9,
        "backSummaryDelta": 12
      }
    }
  }
